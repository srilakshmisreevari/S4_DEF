{
  "name": "zotc-schedorders",
  "version": "1.0.0",
  "private": true,
  "description": "Scheduled orders by terminal, customer and destination (Fiori Elements V4 Analytical List Page)",
  "scripts": {
    "start": "fiori run --open index.html",
    "build": "ui5 build --clean-dest",
    "build:cf": "ui5 build preload --clean-dest --config ui5-deploy.yaml --include-task=generateCachebusterInfo",
    "build:mta": "rimraf resources mta_archives && mbt build",
    "deploy": "cf deploy mta_archives/zotc-schedorders_1.0.0.mtar",
    "undeploy": "cf undeploy zotc-schedorders --delete-services --delete-service-keys --delete-service-brokers"
  },
  "devDependencies": {
    "@sap/ux-ui5-tooling": "1",
    "@ui5/cli": "^3",
    "mbt": "^1",
    "rimraf": "^5",
    "ui5-task-zipper": "^3"
  }
}
