{
  "_version": "1.42.0",
  "sap.app": {
    "id": "zbrf.viewer",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": { "version": "1.0.0" },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "mainService": {
        "uri": "sap/opu/odata4/sap/zui_brf_viewer_o4/srvd/sap/zui_brf_viewer/0001/",
        "type": "OData",
        "settings": { "odataVersion": "4.0" }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "display": {
          "semanticObject": "BRFPlusCatalog",
          "action": "display",
          "title": "{{appTitle}}",
          "signature": { "parameters": {}, "additionalParameters": "allowed" }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true },
    "fullWidth": true
  },
  "sap.cloud": {
    "public": true,
    "service": "zbrf.viewer.service"
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.108.0",
      "libs": {
        "sap.ui.core": {},
        "sap.m": {},
        "sap.f": {},
        "sap.ui.layout": {},
        "sap.ui.table": {},
        "sap.ui.comp": {},
        "sap.ui.export": { "lazy": true }
      }
    },
    "contentDensities": { "compact": true, "cozy": true },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": { "bundleName": "zbrf.viewer.i18n.i18n" }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": false,
          "earlyRequests": true,
          "groupId": "$direct"
        }
      }
    },
    "resources": { "css": [ { "uri": "css/style.css" } ] },
    "rootView": {
      "viewName": "zbrf.viewer.view.App",
      "type": "XML",
      "async": true,
      "id": "app"
    }
  }
}
