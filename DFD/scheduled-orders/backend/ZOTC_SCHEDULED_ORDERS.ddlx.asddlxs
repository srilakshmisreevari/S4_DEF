  @UI.lineItem: [{ position: 90 }]
  @UI.identification: [{ position: 170 }]
  PurchaseOrder;
  @EndUserText.label: 'PO Item'
  PurchaseOrderItem;
  @EndUserText.label: 'PO Type'
  PurchaseOrderType;
  @EndUserText.label: 'PO Assigned to Sales Order'
  PoIsAssignedToSalesOrder;
  @EndUserText.label: 'Goods Supplier (WL)'
  GoodsSupplierPartner;
  @EndUserText.label: 'Goods Supplier Name'
  GoodsSupplierPartnerName;
  @EndUserText.label: 'PO Goods Supplier'
  PurchaseOrderGoodsSupplier;
  @EndUserText.label: 'PO Goods Supplier Name'
  PurchaseOrderGoodsSupplierName;
  @EndUserText.label: 'Goods Receipt Posted'
  HasGoodsReceipt;
  @EndUserText.label: 'Billing Status'
  OrderRelatedBillingStatus;

  @EndUserText.label: 'Delivery'
  @UI.lineItem: [{ position: 100 }]
  @UI.identification: [{ position: 180 }]
  Delivery;
  @EndUserText.label: 'Delivery Not Goods Issued'
  DeliveryNotGoodsIssued;

  @EndUserText.label: 'Freight Unit'
  FreightUnit;
  @EndUserText.label: 'Freight Order'
  @UI.lineItem: [{ position: 110 }]
  @UI.identification: [{ position: 190 }]
  FreightOrder;
  @EndUserText.label: 'TM Planning Status'
  TMPlanningStatus;
  @EndUserText.label: 'FO Lifecycle Status'
  FreightOrderLifecycleStatus;
  @EndUserText.label: 'Planned Pickup'
  @UI.lineItem: [{ position: 120 }]
  @UI.identification: [{ position: 200 }]
  PlannedPickupDateTime;
  @EndUserText.label: 'TM Document Exists'
  HasTMDocument;

  @EndUserText.label: 'Status Bucket'
  @UI.lineItem: [{ position: 130 }]
  @UI.selectionField: [{ position: 60 }]
  @UI.identification: [{ position: 210 }]
  StatusBucket;

  @EndUserText.label: 'Third Party Without PO'
  @UI.lineItem: [{ position: 140 }]
  @UI.identification: [{ position: 220 }]
  ThirdPartyWithoutPO;
  @EndUserText.label: 'PO With Zero Confirmed Qty'
  @UI.lineItem: [{ position: 150 }]
